{
  "name": "canoe-launcher",
  "productName": "Canoe Launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cross-platform Minecraft modpack launcher for Canoe Studio packs.",
  "author": {
    "name": "Canoe Studio"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "core:build": "node scripts/gradle-core.mjs :launcher-core:build",
    "core:run": "node scripts/gradle-core.mjs :launcher-core:run",
    "dev": "npm run core:build && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run core:build && vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "lucide-vue-next": "^0.468.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "studio.canoe.launcher",
    "productName": "Canoe Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "launcher-core/build/libs/canoe-launcher-core.jar"
    ],
    "extraResources": [
      {
        "from": "launcher-core/build/libs/canoe-launcher-core.jar",
        "to": "launcher-core/canoe-launcher-core.jar"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
